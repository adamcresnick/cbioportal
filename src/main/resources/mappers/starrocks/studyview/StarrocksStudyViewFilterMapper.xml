<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.cbioportal.infrastructure.repository.starrocks.studyview.StarrocksStudyViewFilterMapper">
    <!-- Base filters needed before clinical and genomic chart-domain ports are enabled. -->
    <sql id="sampleUniqueIdsFromStudyViewFilter">
        SELECT base_sample.sample_unique_id
        FROM sample_derived base_sample
        WHERE 1 = 1
        <if test="studyViewFilterContext.customDataFilterCancerStudies != null and !studyViewFilterContext.customDataFilterCancerStudies.isEmpty()">
            AND base_sample.cancer_study_identifier IN
            <foreach item="studyId" collection="studyViewFilterContext.customDataFilterCancerStudies" open="(" separator="," close=")">
                #{studyId}
            </foreach>
        </if>
        <bind name="filteredSampleIdentifiers" value="studyViewFilterContext.filteredSampleIdentifiers()" />
        <if test="filteredSampleIdentifiers != null and filteredSampleIdentifiers.length > 0">
            AND base_sample.sample_unique_id IN
            <foreach item="sampleIdentifier" collection="filteredSampleIdentifiers" open="(" separator="," close=")">
                #{sampleIdentifier}
            </foreach>
        </if>
        <if test="studyViewFilterContext.caseLists != null and !studyViewFilterContext.caseLists.isEmpty()">
            <foreach item="listGroup" collection="studyViewFilterContext.caseLists">
                <if test="listGroup != null and !listGroup.isEmpty()">
                AND base_sample.internal_id IN (
                    SELECT case_membership.sample_id
                    FROM sample_list_list case_membership
                    INNER JOIN sample_list case_list ON case_membership.list_id = case_list.list_id
                    WHERE
                    <foreach item="listId" collection="listGroup" open="(" separator=" OR " close=")">
                        case_list.stable_id = CONCAT(base_sample.cancer_study_identifier, '_', #{listId})
                    </foreach>
                )
                </if>
            </foreach>
        </if>
        <if test="studyViewFilterContext.genomicProfiles != null and !studyViewFilterContext.genomicProfiles.isEmpty()">
            <foreach item="profileGroup" collection="studyViewFilterContext.genomicProfiles">
                <if test="profileGroup != null and !profileGroup.isEmpty()">
                AND base_sample.internal_id IN (
                    SELECT profile_sample.sample_id
                    FROM sample_profile profile_sample
                    INNER JOIN genetic_profile profile
                        ON profile_sample.genetic_profile_id = profile.genetic_profile_id
                    WHERE
                    <foreach item="profileId" collection="profileGroup" open="(" separator=" OR " close=")">
                        profile.stable_id = CONCAT(base_sample.cancer_study_identifier, '_', #{profileId})
                    </foreach>
                )
                </if>
            </foreach>
        </if>
        <if test="studyViewFilterContext.geneFilters != null and !studyViewFilterContext.geneFilters.isEmpty()">
            <foreach item="geneFilter" collection="studyViewFilterContext.geneFilters">
                <foreach item="geneQueryGroup" collection="geneFilter.geneQueries">
                    AND EXISTS (
                        SELECT 1
                        FROM genomic_event_derived gene_event
                        WHERE gene_event.sample_unique_id = base_sample.sample_unique_id
                          AND gene_event.genetic_profile_stable_id IN
                          <foreach item="profileId" collection="geneFilter.molecularProfileIds" open="(" separator="," close=")">
                              #{profileId}
                          </foreach>
                          AND
                          <foreach item="geneQuery" collection="geneQueryGroup" open="(" separator=" OR " close=")">
                              (gene_event.hugo_gene_symbol = #{geneQuery.hugoGeneSymbol}
                              <if test="geneQuery.alterations != null and !geneQuery.alterations.isEmpty()">
                                  AND gene_event.cna_alteration IN
                                  <foreach item="alteration" collection="geneQuery.alterations" open="(" separator="," close=")">
                                      #{alteration.code}
                                  </foreach>
                              </if>)
                          </foreach>
                    )
                </foreach>
            </foreach>
        </if>
        <if test="studyViewFilterContext.structuralVariantFilters != null and !studyViewFilterContext.structuralVariantFilters.isEmpty()">
            <foreach item="structuralVariantFilter" collection="studyViewFilterContext.structuralVariantFilters">
                <foreach item="structuralVariantQueryGroup" collection="structuralVariantFilter.structVarQueries">
                    AND EXISTS (
                        SELECT 1
                        FROM structural_variant sv_filter
                        INNER JOIN genetic_profile sv_profile
                            ON sv_filter.genetic_profile_id = sv_profile.genetic_profile_id
                        LEFT JOIN alteration_driver_annotation sv_driver
                            ON sv_filter.genetic_profile_id = sv_driver.genetic_profile_id
                            AND sv_filter.sample_id = sv_driver.sample_id
                            AND sv_filter.internal_id = sv_driver.alteration_event_id
                        WHERE sv_filter.sample_id = base_sample.internal_id
                          AND sv_profile.stable_id IN
                          <foreach item="profileId" collection="structuralVariantFilter.molecularProfileIds" open="(" separator="," close=")">
                              #{profileId}
                          </foreach>
                          AND
                          <foreach item="svQuery" collection="structuralVariantQueryGroup" open="(" separator=" OR " close=")">
                              (
                                  <choose>
                                      <when test="svQuery.gene1Query.specialValue == @org.cbioportal.legacy.model.StructuralVariantSpecialValue@NO_GENE">
                                          sv_filter.site1_entrez_gene_id IS NULL
                                      </when>
                                      <when test="svQuery.gene1Query.specialValue == @org.cbioportal.legacy.model.StructuralVariantSpecialValue@ANY_GENE">
                                          1 = 1
                                      </when>
                                      <otherwise>
                                          sv_filter.site1_entrez_gene_id = #{svQuery.gene1Query.entrezId}
                                      </otherwise>
                                  </choose>
                                  AND
                                  <choose>
                                      <when test="svQuery.gene2Query.specialValue == @org.cbioportal.legacy.model.StructuralVariantSpecialValue@NO_GENE">
                                          sv_filter.site2_entrez_gene_id IS NULL
                                      </when>
                                      <when test="svQuery.gene2Query.specialValue == @org.cbioportal.legacy.model.StructuralVariantSpecialValue@ANY_GENE">
                                          1 = 1
                                      </when>
                                      <otherwise>
                                          sv_filter.site2_entrez_gene_id = #{svQuery.gene2Query.entrezId}
                                      </otherwise>
                                  </choose>
                                  <if test="!(svQuery.includeGermline and svQuery.includeSomatic and svQuery.includeUnknownStatus)">
                                      AND
                                      <trim prefix="(" suffix=")" prefixOverrides="OR">
                                          <if test="svQuery.includeGermline">
                                              OR LOWER(sv_filter.sv_status) = 'germline'
                                          </if>
                                          <if test="svQuery.includeSomatic">
                                              OR LOWER(sv_filter.sv_status) = 'somatic'
                                          </if>
                                          <if test="svQuery.includeUnknownStatus">
                                              OR LOWER(sv_filter.sv_status) NOT IN ('somatic', 'germline')
                                          </if>
                                          <if test="!svQuery.includeGermline and !svQuery.includeSomatic and !svQuery.includeUnknownStatus">
                                              OR 1 = 0
                                          </if>
                                      </trim>
                                  </if>
                                  <if test="!(svQuery.includeDriver and svQuery.includeVUS and svQuery.includeUnknownOncogenicity)">
                                      AND
                                      <trim prefix="(" suffix=")" prefixOverrides="OR">
                                          <if test="svQuery.includeDriver">
                                              OR LOWER(sv_driver.driver_filter) = 'putative_driver'
                                          </if>
                                          <if test="svQuery.includeVUS">
                                              OR LOWER(sv_driver.driver_filter) = 'putative_passenger'
                                          </if>
                                          <if test="svQuery.includeUnknownOncogenicity">
                                              OR sv_driver.driver_filter IS NULL
                                              OR LOWER(sv_driver.driver_filter) IN ('unknown', 'na', '')
                                          </if>
                                          <if test="!svQuery.includeDriver and !svQuery.includeVUS and !svQuery.includeUnknownOncogenicity">
                                              OR 1 = 0
                                          </if>
                                      </trim>
                                  </if>
                                  <bind name="allSvTiers" value="svQuery.selectedTiers != null and svQuery.selectedTiers.hasAll() and svQuery.includeUnknownTier"/>
                                  <bind name="allExceptUnknownSvTiers" value="svQuery.selectedTiers != null and svQuery.selectedTiers.hasAll() and !svQuery.includeUnknownTier"/>
                                  <choose>
                                      <when test="allExceptUnknownSvTiers">
                                          AND sv_driver.driver_tiers_filter IS NOT NULL
                                          AND LOWER(sv_driver.driver_tiers_filter) NOT IN ('unknown', 'na', '')
                                      </when>
                                      <when test="!allSvTiers">
                                          AND
                                          <trim prefix="(" suffix=")" prefixOverrides="OR">
                                              <if test="svQuery.selectedTiers != null and svQuery.selectedTiers.hasValues()">
                                                  OR sv_driver.driver_tiers_filter IN
                                                  <foreach item="tier" collection="svQuery.selectedTiers" open="(" separator="," close=")">
                                                      #{tier}
                                                  </foreach>
                                              </if>
                                              <if test="svQuery.includeUnknownTier">
                                                  OR sv_driver.driver_tiers_filter IS NULL
                                                  OR LOWER(sv_driver.driver_tiers_filter) IN ('unknown', 'na', '')
                                              </if>
                                              <if test="(svQuery.selectedTiers == null or svQuery.selectedTiers.hasNone()) and !svQuery.includeUnknownTier">
                                                  OR 1 = 0
                                              </if>
                                          </trim>
                                      </when>
                                  </choose>
                              )
                          </foreach>
                    )
                </foreach>
            </foreach>
        </if>
        <if test="studyViewFilterContext.mutationDataFilters != null and !studyViewFilterContext.mutationDataFilters.isEmpty()">
            <foreach item="mutationFilter" collection="studyViewFilterContext.mutationDataFilters">
                <choose>
                    <when test="mutationFilter.categorization == @org.cbioportal.legacy.web.parameter.MutationOption@MUTATED">
                        AND
                        <foreach item="filterValue" collection="mutationFilter.values[0]" open="(" separator=" OR " close=")">
                            <choose>
                                <when test="filterValue.value == 'MUTATED'">
                                    EXISTS (
                                        SELECT 1 FROM genomic_event_derived mutation_event_filter
                                        WHERE mutation_event_filter.sample_unique_id = base_sample.sample_unique_id
                                          AND mutation_event_filter.variant_type = 'mutation'
                                          AND mutation_event_filter.hugo_gene_symbol = #{mutationFilter.hugoGeneSymbol}
                                    )
                                </when>
                                <when test="filterValue.value == 'NOT_MUTATED'">
                                    <include refid="org.cbioportal.infrastructure.repository.starrocks.studyview.StarrocksStudyViewFilterMapper.isProfiledForMutationGene"/>
                                    AND NOT EXISTS (
                                        SELECT 1 FROM genomic_event_derived mutation_event_filter
                                        WHERE mutation_event_filter.sample_unique_id = base_sample.sample_unique_id
                                          AND mutation_event_filter.variant_type = 'mutation'
                                          AND mutation_event_filter.hugo_gene_symbol = #{mutationFilter.hugoGeneSymbol}
                                    )
                                </when>
                                <when test="filterValue.value == 'NOT_PROFILED'">
                                    NOT <include refid="org.cbioportal.infrastructure.repository.starrocks.studyview.StarrocksStudyViewFilterMapper.isProfiledForMutationGene"/>
                                </when>
                                <otherwise>1 = 0</otherwise>
                            </choose>
                        </foreach>
                    </when>
                    <when test="mutationFilter.categorization == @org.cbioportal.legacy.web.parameter.MutationOption@MUTATION_TYPE">
                        <foreach item="mutationTypeGroup" collection="mutationFilter.values">
                            AND EXISTS (
                                SELECT 1 FROM genomic_event_derived mutation_type_filter
                                WHERE mutation_type_filter.sample_unique_id = base_sample.sample_unique_id
                                  AND mutation_type_filter.variant_type = 'mutation'
                                  AND mutation_type_filter.hugo_gene_symbol = #{mutationFilter.hugoGeneSymbol}
                                  AND mutation_type_filter.mutation_type IN
                                  <foreach item="filterValue" collection="mutationTypeGroup" open="(" separator="," close=")">
                                      #{filterValue.value}
                                  </foreach>
                            )
                        </foreach>
                    </when>
                </choose>
            </foreach>
        </if>
        <if test="studyViewFilterContext.genomicDataFilters != null and !studyViewFilterContext.genomicDataFilters.isEmpty()">
            <foreach item="genomicFilter" collection="studyViewFilterContext.genomicDataFilters">
                AND
                <foreach item="filterValue" collection="genomicFilter.values" open="(" separator=" OR " close=")">
                    <choose>
                        <when test="genomicFilter.profileType == 'cna' or genomicFilter.profileType == 'gistic'">
                            <choose>
                                <when test="filterValue.value == 'NA'">
                                    NOT EXISTS (
                                        SELECT 1 FROM genetic_alteration_derived cna_filter
                                        WHERE cna_filter.sample_unique_id = base_sample.sample_unique_id
                                          AND cna_filter.profile_type = #{genomicFilter.profileType}
                                          AND cna_filter.hugo_gene_symbol = #{genomicFilter.hugoGeneSymbol}
                                          AND NOT (<include refid="org.cbioportal.infrastructure.repository.starrocks.studyview.StarrocksStudyViewFilterMapper.isAttributeValueNA"><property name="attribute_value" value="cna_filter.alteration_value"/></include>)
                                    )
                                </when>
                                <otherwise>
                                    EXISTS (
                                        SELECT 1 FROM genetic_alteration_derived cna_filter
                                        WHERE cna_filter.sample_unique_id = base_sample.sample_unique_id
                                          AND cna_filter.profile_type = #{genomicFilter.profileType}
                                          AND cna_filter.hugo_gene_symbol = #{genomicFilter.hugoGeneSymbol}
                                          AND cna_filter.alteration_value = #{filterValue.value}
                                    )
                                </otherwise>
                            </choose>
                        </when>
                        <otherwise>
                            <choose>
                                <when test="filterValue.value == 'NA'">
                                    NOT EXISTS (
                                        SELECT 1 FROM genetic_alteration_derived numerical_genomic_filter
                                        WHERE numerical_genomic_filter.sample_unique_id = base_sample.sample_unique_id
                                          AND numerical_genomic_filter.profile_type = #{genomicFilter.profileType}
                                          AND numerical_genomic_filter.hugo_gene_symbol = #{genomicFilter.hugoGeneSymbol}
                                          AND NOT (<include refid="org.cbioportal.infrastructure.repository.starrocks.studyview.StarrocksStudyViewFilterMapper.isAttributeValueNA"><property name="attribute_value" value="numerical_genomic_filter.alteration_value"/></include>)
                                    )
                                </when>
                                <otherwise>
                                    EXISTS (
                                        SELECT 1 FROM genetic_alteration_derived numerical_genomic_filter
                                        WHERE numerical_genomic_filter.sample_unique_id = base_sample.sample_unique_id
                                          AND numerical_genomic_filter.profile_type = #{genomicFilter.profileType}
                                          AND numerical_genomic_filter.hugo_gene_symbol = #{genomicFilter.hugoGeneSymbol}
                                          <include refid="org.cbioportal.infrastructure.repository.starrocks.studyview.StarrocksStudyViewFilterMapper.genomicDataValueMatches"/>
                                    )
                                </otherwise>
                            </choose>
                        </otherwise>
                    </choose>
                </foreach>
            </foreach>
        </if>
        <if test="studyViewFilterContext.genericAssayDataFilters != null and !studyViewFilterContext.genericAssayDataFilters.isEmpty()">
            <foreach item="genericFilter" collection="studyViewFilterContext.genericAssayDataFilters">
                AND
                <foreach item="filterValue" collection="genericFilter.values" open="(" separator=" OR " close=")">
                    <choose>
                        <when test="filterValue.value == 'NA'">
                            NOT EXISTS (
                                SELECT 1
                                FROM generic_assay_data_derived generic_na_filter
                                WHERE generic_na_filter.profile_type = #{genericFilter.profileType}
                                  AND generic_na_filter.entity_stable_id = #{genericFilter.stableId}
                                  AND COALESCE(generic_na_filter.patient_level, 0) != 1
                                  AND generic_na_filter.sample_unique_id = base_sample.sample_unique_id
                                  AND NOT (
                                      <include refid="org.cbioportal.infrastructure.repository.starrocks.studyview.StarrocksStudyViewFilterMapper.isAttributeValueNA">
                                          <property name="attribute_value" value="generic_na_filter.value"/>
                                      </include>
                                  )
                            )
                            AND NOT EXISTS (
                                SELECT 1
                                FROM generic_assay_data_derived generic_patient_na_filter
                                WHERE generic_patient_na_filter.profile_type = #{genericFilter.profileType}
                                  AND generic_patient_na_filter.entity_stable_id = #{genericFilter.stableId}
                                  AND generic_patient_na_filter.patient_level = 1
                                  AND generic_patient_na_filter.patient_unique_id = base_sample.patient_unique_id
                                  AND NOT (
                                      <include refid="org.cbioportal.infrastructure.repository.starrocks.studyview.StarrocksStudyViewFilterMapper.isAttributeValueNA">
                                          <property name="attribute_value" value="generic_patient_na_filter.value"/>
                                      </include>
                                  )
                            )
                        </when>
                        <otherwise>
                            (EXISTS (
                                SELECT 1
                                FROM generic_assay_data_derived generic_value_filter
                                WHERE generic_value_filter.profile_type = #{genericFilter.profileType}
                                  AND generic_value_filter.entity_stable_id = #{genericFilter.stableId}
                                  AND COALESCE(generic_value_filter.patient_level, 0) != 1
                                  AND generic_value_filter.sample_unique_id = base_sample.sample_unique_id
                                  <include refid="org.cbioportal.infrastructure.repository.starrocks.studyview.StarrocksStudyViewFilterMapper.genericAssayValueMatches">
                                      <property name="generic_alias" value="generic_value_filter"/>
                                  </include>
                            )
                            OR EXISTS (
                                SELECT 1
                                FROM generic_assay_data_derived generic_patient_value_filter
                                WHERE generic_patient_value_filter.profile_type = #{genericFilter.profileType}
                                  AND generic_patient_value_filter.entity_stable_id = #{genericFilter.stableId}
                                  AND generic_patient_value_filter.patient_level = 1
                                  AND generic_patient_value_filter.patient_unique_id = base_sample.patient_unique_id
                                  <include refid="org.cbioportal.infrastructure.repository.starrocks.studyview.StarrocksStudyViewFilterMapper.genericAssayValueMatches">
                                      <property name="generic_alias" value="generic_patient_value_filter"/>
                                  </include>
                            ))
                        </otherwise>
                    </choose>
                </foreach>
            </foreach>
        </if>
        <if test="studyViewFilterContext.genericAssaySelectionFilters != null and !studyViewFilterContext.genericAssaySelectionFilters.isEmpty()">
            <foreach item="selectionFilter" collection="studyViewFilterContext.genericAssaySelectionFilters">
                <foreach item="selectionGroup" collection="selectionFilter.values">
                    AND EXISTS (
                        SELECT 1
                        FROM generic_assay_data_derived generic_selection
                        WHERE generic_selection.profile_type = #{selectionFilter.profileType}
                          AND generic_selection.datatype != 'LIMIT-VALUE'
                          <choose>
                              <when test="selectionFilter.patientLevel">
                                  AND generic_selection.patient_unique_id = base_sample.patient_unique_id
                              </when>
                              <otherwise>
                                  AND generic_selection.sample_unique_id = base_sample.sample_unique_id
                              </otherwise>
                          </choose>
                          AND
                          <foreach item="selectionValue" collection="selectionGroup" open="(" separator=" OR " close=")">
                              (generic_selection.entity_stable_id = #{selectionValue.stableId}
                              AND
                              <choose>
                                  <when test="selectionValue.value == 'NA'">
                                      <include refid="org.cbioportal.infrastructure.repository.starrocks.studyview.StarrocksStudyViewFilterMapper.isAttributeValueNA">
                                          <property name="attribute_value" value="generic_selection.value"/>
                                      </include>
                                  </when>
                                  <otherwise>
                                      LOWER(TRIM(generic_selection.value)) = LOWER(TRIM(#{selectionValue.value}))
                                  </otherwise>
                              </choose>)
                          </foreach>
                    )
                </foreach>
            </foreach>
        </if>
        <if test="studyViewFilterContext.clinicalDataFilters != null and !studyViewFilterContext.clinicalDataFilters.isEmpty()">
            <foreach item="clinicalDataFilter" collection="studyViewFilterContext.clinicalDataFilters">
                AND (
                <foreach item="filterValue" collection="clinicalDataFilter.values" open="(" separator=" OR " close=")">
                    <choose>
                        <when test="filterValue.value == 'NA'">
                            NOT EXISTS (
                                SELECT 1
                                FROM clinical_data_derived sample_clinical_filter
                                WHERE sample_clinical_filter.attribute_name = #{clinicalDataFilter.attributeId}
                                  AND sample_clinical_filter.sample_unique_id = base_sample.sample_unique_id
                                  AND NOT (<include refid="org.cbioportal.infrastructure.repository.starrocks.studyview.StarrocksStudyViewFilterMapper.isAttributeValueNA"><property name="attribute_value" value="sample_clinical_filter.attribute_value"/></include>)
                            )
                            AND NOT EXISTS (
                                SELECT 1
                                FROM clinical_data_derived patient_clinical_filter
                                WHERE patient_clinical_filter.attribute_name = #{clinicalDataFilter.attributeId}
                                  AND patient_clinical_filter.patient_unique_id = base_sample.patient_unique_id
                                  AND patient_clinical_filter.type = 'patient'
                                  AND NOT (<include refid="org.cbioportal.infrastructure.repository.starrocks.studyview.StarrocksStudyViewFilterMapper.isAttributeValueNA"><property name="attribute_value" value="patient_clinical_filter.attribute_value"/></include>)
                            )
                        </when>
                        <otherwise>
                            (
                                EXISTS (
                                    SELECT 1
                                    FROM clinical_data_derived sample_clinical_filter
                                    WHERE sample_clinical_filter.attribute_name = #{clinicalDataFilter.attributeId}
                                      AND sample_clinical_filter.sample_unique_id = base_sample.sample_unique_id
                                      <include refid="org.cbioportal.infrastructure.repository.starrocks.studyview.StarrocksStudyViewFilterMapper.clinicalDataValueMatches">
                                          <property name="clinical_alias" value="sample_clinical_filter"/>
                                      </include>
                                )
                                OR EXISTS (
                                    SELECT 1
                                    FROM clinical_data_derived patient_clinical_filter
                                    WHERE patient_clinical_filter.attribute_name = #{clinicalDataFilter.attributeId}
                                      AND patient_clinical_filter.patient_unique_id = base_sample.patient_unique_id
                                      AND patient_clinical_filter.type = 'patient'
                                      <include refid="org.cbioportal.infrastructure.repository.starrocks.studyview.StarrocksStudyViewFilterMapper.clinicalDataValueMatches">
                                          <property name="clinical_alias" value="patient_clinical_filter"/>
                                      </include>
                                )
                            )
                        </otherwise>
                    </choose>
                </foreach>
                )
            </foreach>
        </if>
        <if test="studyViewFilterContext.clinicalEventFilters != null and !studyViewFilterContext.clinicalEventFilters.isEmpty()">
            <foreach item="eventFilter" collection="studyViewFilterContext.clinicalEventFilters">
                AND EXISTS (
                    SELECT 1
                    FROM clinical_event_data_derived event_filter
                    WHERE event_filter.patient_unique_id = base_sample.patient_unique_id
                      AND
                      <foreach item="filterValue" collection="eventFilter.values" open="(" separator=" OR " close=")">
                          LOWER(event_filter.event_type) = LOWER(#{filterValue.value})
                      </foreach>
                )
            </foreach>
        </if>
        <if test="studyViewFilterContext.patientTreatmentFilters != null and studyViewFilterContext.patientTreatmentFilters.filters != null and !studyViewFilterContext.patientTreatmentFilters.filters.isEmpty()">
            <foreach item="treatmentGroup" collection="studyViewFilterContext.patientTreatmentFilters.filters">
                AND EXISTS (
                    SELECT 1
                    FROM clinical_event_data_derived patient_treatment
                    WHERE patient_treatment.patient_unique_id = base_sample.patient_unique_id
                      AND LOWER(patient_treatment.event_type) = 'treatment'
                      AND patient_treatment.`key` = 'AGENT'
                      AND patient_treatment.value IN
                      <foreach item="treatmentFilter" collection="treatmentGroup.filters" open="(" separator="," close=")">
                          #{treatmentFilter.treatment}
                      </foreach>
                )
            </foreach>
        </if>
        <if test="studyViewFilterContext.sampleTreatmentFilters != null and studyViewFilterContext.sampleTreatmentFilters.filters != null and !studyViewFilterContext.sampleTreatmentFilters.filters.isEmpty()">
            <foreach item="treatmentGroup" collection="studyViewFilterContext.sampleTreatmentFilters.filters">
                AND (
                <foreach item="treatmentFilter" collection="treatmentGroup.filters" open="(" separator=" OR " close=")">
                    EXISTS (
                        SELECT 1
                        FROM clinical_event_data_derived acquisition
                        INNER JOIN clinical_event_data_derived sample_treatment
                            ON sample_treatment.patient_unique_id = acquisition.patient_unique_id
                        WHERE acquisition.patient_unique_id = base_sample.patient_unique_id
                          AND acquisition.cancer_study_identifier = base_sample.cancer_study_identifier
                          AND acquisition.`key` = 'SAMPLE_ID'
                          AND acquisition.value = base_sample.sample_stable_id
                          AND LOWER(acquisition.event_type) IN ('sample acquisition', 'specimen')
                          AND LOWER(sample_treatment.event_type) = 'treatment'
                          AND sample_treatment.`key` = 'AGENT'
                          AND sample_treatment.value = #{treatmentFilter.treatment}
                        <choose>
                            <when test="treatmentFilter.time.name() == 'Pre'">
                                AND acquisition.start_date &lt;= sample_treatment.start_date
                            </when>
                            <otherwise>
                                AND acquisition.start_date &gt; sample_treatment.start_date
                            </otherwise>
                        </choose>
                    )
                </foreach>
                )
            </foreach>
        </if>
    </sql>

    <sql id="isProfiledForMutationGene">
        EXISTS (
            SELECT 1
            FROM sample_to_gene_panel_derived mutation_panel
            WHERE mutation_panel.sample_unique_id = base_sample.sample_unique_id
              AND mutation_panel.alteration_type = 'MUTATION_EXTENDED'
              AND (
                  mutation_panel.gene_panel_id = 'WES'
                  OR EXISTS (
                      SELECT 1 FROM gene_panel_to_gene_derived mutation_panel_gene
                      WHERE mutation_panel_gene.gene_panel_id = mutation_panel.gene_panel_id
                        AND mutation_panel_gene.gene = #{mutationFilter.hugoGeneSymbol}
                  )
              )
        )
    </sql>

    <sql id="applyStudyViewFilterUsingSampleId">
        sample_unique_id IN (
            <include refid="org.cbioportal.infrastructure.repository.starrocks.studyview.StarrocksStudyViewFilterMapper.sampleUniqueIdsFromStudyViewFilter"/>
        )
    </sql>

    <sql id="applyStudyViewFilterUsingPatientId">
        patient_unique_id IN (
            SELECT patient_unique_id
            FROM sample_derived
            WHERE sample_unique_id IN (
                <include refid="org.cbioportal.infrastructure.repository.starrocks.studyview.StarrocksStudyViewFilterMapper.sampleUniqueIdsFromStudyViewFilter"/>
            )
        )
    </sql>

    <sql id="isAttributeValueNA">
        ${attribute_value} IS NULL
        OR TRIM(${attribute_value}) = ''
        OR UPPER(TRIM(${attribute_value})) IN ('NA', 'NAN', 'N/A')
    </sql>

    <sql id="clinicalDataValueMatches">
        <choose>
            <when test="filterValue.value != null">
                AND LOWER(TRIM(${clinical_alias}.attribute_value)) = LOWER(TRIM(#{filterValue.value}))
            </when>
            <when test="filterValue.start != null or filterValue.end != null">
                AND ${clinical_alias}.attribute_value REGEXP '^[&lt;>]?=?[-+]?[0-9]*[.]?[0-9]+$'
                <if test="filterValue.start != null and filterValue.start == filterValue.end">
                    AND ABS(CAST(REGEXP_REPLACE(${clinical_alias}.attribute_value, '^[&lt;>]=?', '') AS DOUBLE) - #{filterValue.start}) &lt; 0.00000000001
                </if>
                <if test="filterValue.start != null and filterValue.start != filterValue.end">
                    AND CAST(REGEXP_REPLACE(${clinical_alias}.attribute_value, '^[&lt;>]=?', '') AS DOUBLE) &gt; #{filterValue.start}
                </if>
                <if test="filterValue.end != null and filterValue.start != filterValue.end">
                    AND CAST(REGEXP_REPLACE(${clinical_alias}.attribute_value, '^[&lt;>]=?', '') AS DOUBLE) &lt;= #{filterValue.end}
                </if>
            </when>
        </choose>
    </sql>

    <sql id="genomicDataValueMatches">
        <choose>
            <when test="filterValue.value != null">
                AND LOWER(TRIM(numerical_genomic_filter.alteration_value)) = LOWER(TRIM(#{filterValue.value}))
            </when>
            <when test="filterValue.start != null or filterValue.end != null">
                AND numerical_genomic_filter.alteration_value REGEXP '^[&lt;>]?=?[-+]?[0-9]*[.]?[0-9]+$'
                <if test="filterValue.start != null and filterValue.start == filterValue.end">
                    AND ABS(CAST(REGEXP_REPLACE(numerical_genomic_filter.alteration_value, '^[&lt;>]=?', '') AS DOUBLE) - #{filterValue.start}) &lt; 0.00000000001
                </if>
                <if test="filterValue.start != null and filterValue.start != filterValue.end">
                    AND CAST(REGEXP_REPLACE(numerical_genomic_filter.alteration_value, '^[&lt;>]=?', '') AS DOUBLE) &gt; #{filterValue.start}
                </if>
                <if test="filterValue.end != null and filterValue.start != filterValue.end">
                    AND CAST(REGEXP_REPLACE(numerical_genomic_filter.alteration_value, '^[&lt;>]=?', '') AS DOUBLE) &lt;= #{filterValue.end}
                </if>
            </when>
        </choose>
    </sql>

    <sql id="genericAssayValueMatches">
        <choose>
            <when test="filterValue.value != null">
                AND LOWER(TRIM(${generic_alias}.value)) = LOWER(TRIM(#{filterValue.value}))
            </when>
            <otherwise>
                AND ${generic_alias}.value REGEXP '^[&lt;>]?=?[-+]?[0-9]*[.]?[0-9]+$'
                <if test="filterValue.start != null and filterValue.start == filterValue.end">
                    AND ABS(CAST(REGEXP_REPLACE(${generic_alias}.value, '^[&lt;>]=?', '') AS DOUBLE) - #{filterValue.start}) &lt; 0.00000000001
                </if>
                <if test="filterValue.start != null and filterValue.start != filterValue.end">
                    AND CAST(REGEXP_REPLACE(${generic_alias}.value, '^[&lt;>]=?', '') AS DOUBLE) &gt; #{filterValue.start}
                </if>
                <if test="filterValue.end != null and filterValue.start != filterValue.end">
                    AND CAST(REGEXP_REPLACE(${generic_alias}.value, '^[&lt;>]=?', '') AS DOUBLE) &lt;= #{filterValue.end}
                </if>
            </otherwise>
        </choose>
    </sql>

    <sql id="normalizeAttributeValue">
        CASE
            WHEN <include refid="org.cbioportal.infrastructure.repository.starrocks.studyview.StarrocksStudyViewFilterMapper.isAttributeValueNA"><property name="attribute_value" value="${attribute_value}"/></include>
            THEN 'NA'
            ELSE ${attribute_value}
        END
    </sql>
</mapper>
